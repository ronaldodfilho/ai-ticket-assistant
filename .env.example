# Backend
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-flash-latest
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# PostgreSQL (com SPRING_PROFILES_ACTIVE=postgres)
SPRING_PROFILES_ACTIVE=
DATABASE_URL=jdbc:postgresql://localhost:5432/aiticket_db
DATABASE_USERNAME=aiticket
DATABASE_PASSWORD=password

# Frontend
# URL da API no build de produção (em desenvolvimento o Vite usa proxy para /api)
VITE_API_URL=
# Destino do proxy /api no servidor de desenvolvimento
BACKEND_URL=http://localhost:8080

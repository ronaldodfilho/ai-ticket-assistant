# Copie para .env na raiz do projeto e cole a chave. O backend lê o arquivo automaticamente.
# Sem chave (linha vazia), o sistema funciona no modo local.
GEMINI_API_KEY=

# Opcionais
GEMINI_MODEL=gemini-flash-latest
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# PostgreSQL: usados com o perfil postgres, que deve ser ativado no terminal
# (SPRING_PROFILES_ACTIVE=postgres), não neste arquivo.
DATABASE_URL=jdbc:postgresql://localhost:5432/aiticket_db
DATABASE_USERNAME=aiticket
DATABASE_PASSWORD=password

# Frontend (lidos pelo Vite, não pelo backend)
# VITE_API_URL=URL da API no build de produção
# BACKEND_URL=destino do proxy /api em desenvolvimento (padrão http://localhost:8080)
